%% Rebar3 configuration for elmdb-rs project

%% Erlang compiler options
{erl_opts, [debug_info]}.

%% Dependencies
{deps, []}.

%% Pre/Post compile hooks
{pre_hooks, [
    {"(linux|darwin|solaris|freebsd)", compile, "native/elmdb_nif/build_c_nif.sh"}
]}.

%% Test configuration
{eunit_opts, [
    verbose,
    {report, {eunit_surefire, [{dir, "_build/test/logs"}]}}
]}.

{eunit_compile_opts, [
    {src_dirs, ["src", "test"]}
]}.

%% Shell configuration
{shell, [
    {config, "config/sys.config"},
    {apps, [elmdb]}
]}.

%% Coverage analysis
{cover_enabled, true}.
{cover_opts, [verbose]}.

%% Profiles for different build configurations
{profiles, [
    {prod, [
        {erl_opts, [no_debug_info]}
    ]},
    {test, [
        {deps, []},
        {erl_opts, [debug_info, export_all]}
    ]}
]}.
