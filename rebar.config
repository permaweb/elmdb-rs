{erl_opts, [debug_info]}.
{deps, []}.

%% Build the C NIF (LMDB + elmdb_nif.c) before compiling Erlang.
{pre_hooks, [
    {"(linux|darwin|solaris|freebsd)", compile, "native/elmdb_nif/build_c_nif.sh"}
]}.

{eunit_opts, [verbose]}.
{eunit_compile_opts, [{src_dirs, ["src", "test"]}]}.

{shell, [{apps, [elmdb]}]}.

{cover_enabled, true}.

{profiles, [
    {prod, [{erl_opts, [no_debug_info]}]}
]}.
